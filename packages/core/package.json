{
  "name": "@spica/core",
  "version": "0.1.0",
  "private": true,
  "description": "Spica agent core: the agent loop, model providers, built-in tools and the multi-agent runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/core",
    "smoke:deepseek": "node --env-file=../../.env.local scripts/smoke.ts deepseek",
    "smoke:claude": "node --env-file=../../.env.local scripts/smoke.ts claude",
    "smoke:team": "node --env-file=../../.env.local scripts/smoke-team.ts",
    "smoke:project": "node --env-file=../../.env.local scripts/smoke-project.ts",
    "journeys": "node --env-file=../../.env.local ../../plugins/example-eval/src/run.ts --only J2,J3,J4,J5,J7",
    "export:log": "node scripts/export-log.ts",
    "smoke:mail": "node --env-file=../../.env.local scripts/smoke-mail.ts",
    "smoke:guard": "node --env-file=../../.env.local scripts/smoke-guard.ts",
    "check:electron-host": "electron scripts/electron/host-check.ts",
    "catalog:age": "node scripts/catalog-age.ts"
  },
  "dependencies": {
    "@spica/protocol": "*"
  }
}
