{
  "name": "@spica/extract",
  "version": "0.1.0",
  "private": true,
  "description": "Spica file extractors: PDF, Word, Excel, PowerPoint, CSV and text to model-readable text with structure and metadata.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/extract",
    "smoke:extract": "node scripts/smoke.ts",
    "smoke:extract:agent": "node --env-file=../../.env.local scripts/smoke-agent.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "saxes": "6.0.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@spica/core": "*",
    "@spica/protocol": "*",
    "docx": "9.15.3",
    "pdf-lib": "1.17.1",
    "write-excel-file": "^4.1.1"
  }
}
