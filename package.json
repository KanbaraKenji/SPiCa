{
  "name": "spica",
  "version": "0.1.0-rc.2",
  "private": true,
  "description": "Spica: an open-source desktop agent workbench for Windows.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @spica/desktop",
    "build": "npm run build -w @spica/desktop",
    "brand:build": "npm run brand:build -w @spica/brand",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "scan:sensitive": "node scripts/sensitive-words/scan.mjs",
    "smoke:deepseek": "npm run smoke:deepseek -w @spica/core",
    "smoke:claude": "npm run smoke:claude -w @spica/core",
    "journeys": "npm run journeys -w @spica/core",
    "journey:j6": "npm run journey:j6 -w @spica/plugins",
    "shots": "npm run shots -w @spica/desktop",
    "acceptance": "node scripts/acceptance.mjs",
    "dist": "npm run dist -w @spica/desktop",
    "release:prepare": "node scripts/release/prepare.mjs",
    "pack:plugins": "node scripts/release/pack-plugins.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
