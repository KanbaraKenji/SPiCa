<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>__DISPLAY__</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="bar">
    <form id="add-form" class="add">
      <input id="new-title" placeholder="新的一条" autocomplete="off" maxlength="200">
      <button type="submit" class="primary">添加</button>
    </form>
    <select id="filter" aria-label="筛选">
      <option value="">全部</option>
      <option value="open">未完成</option>
      <option value="done">已完成</option>
    </select>
  </header>
  <p id="status" class="status" role="status"></p>
  <ul id="items" class="items" aria-label="列表"></ul>
  <p id="empty" class="muted" hidden>没有内容。</p>
  <script src="app.js"></script>
</body>
</html>
