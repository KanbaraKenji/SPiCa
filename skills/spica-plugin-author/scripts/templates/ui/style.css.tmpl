/* Colours come from Spica (--spica-*) and change with light / dark mode.
   The fallbacks only matter when the page is opened outside Spica. */
:root {
  color-scheme: light dark;
  --bg: var(--spica-bg, #ffffff);
  --surface: var(--spica-surface, #f4f4f5);
  --fg: var(--spica-fg, #18181b);
  --muted: var(--spica-muted, #71717a);
  --border: var(--spica-border, #e4e4e7);
  --accent: var(--spica-accent, #2563eb);
  --danger: var(--spica-danger, #dc2626);
  --radius: var(--spica-radius, 6px);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --bg: var(--spica-bg, #18181b);
    --surface: var(--spica-surface, #27272a);
    --fg: var(--spica-fg, #f4f4f5);
    --muted: var(--spica-muted, #a1a1aa);
    --border: var(--spica-border, #3f3f46);
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body { background: var(--bg); color: var(--fg); font: 14px/1.5 var(--spica-font, system-ui, sans-serif); padding: 10px; }
.bar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.add { display: flex; gap: 8px; flex: 1; min-width: 200px; }
.add input { flex: 1; min-width: 0; }
input, select, button { font: inherit; color: inherit; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 4px 8px; }
button { background: var(--surface); cursor: pointer; padding: 4px 12px; }
button.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); }
button.danger { color: var(--danger); }
.status { min-height: 1.5em; margin: 6px 0; color: var(--muted); }
.status.error { color: var(--danger); }
.items { list-style: none; margin: 0; padding: 0; }
.items li { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-bottom: 1px solid var(--border); }
.items .title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.items .meta { color: var(--muted); font-size: 12px; white-space: nowrap; }
.muted { color: var(--muted); }
