# Dependencies and build output
node_modules/
dist/
out/
# Packaged installers (electron-builder output); not scripts/release/
apps/*/release/
# Bundled libraries for the Agent's scripts (apps/desktop/scripts/node-libs.mjs)
apps/*/node-libs/
# uv, fetched at build time (apps/desktop/scripts/uv.mjs)
apps/*/uv/
apps/*/.node-libs-*.cjs
coverage/
*.tsbuildinfo
.vite/

# Logs
npm-debug.log*
*.log

# Local secrets: model keys never enter the repository
.env
.env.local
.env.*.local

# Editors and local tooling
.idea/
.vscode/
.venv/
.DS_Store
Thumbs.db

# Private working notes of the maintainer (not part of the open-source tree)
PROMPT.md
LEDGER.md
ledger-briefs/
ledger-archive/
scripts/dev/open-subsession.ps1

